# Express API (Railway public URL, no trailing slash). Required on Vercel so /api/data/* can proxy to Express.
# Local dev: optional — defaults to http://127.0.0.1:3053 when Express runs on port 3053.
# EXPRESS_API_URL=https://your-app.up.railway.app

# Legacy alias (same value as EXPRESS_API_URL):
# CRM_EXPRESS_INTERNAL_URL=

# Supabase: configure SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY on the Express server only (not Next).

# Optional: shared secret if Express has CRM_API_SECRET set (usually leave unset).
# CRM_API_SECRET=

# Dev user id for mentorai user-background-studio rewrites (if used).
# NEXT_PUBLIC_MENTORAI_USER_ID=dev-user-001

# Marketing landing GitHub CTA (optional).
# NEXT_PUBLIC_LANDING_GITHUB_URL=https://github.com/Luckee-Core/code-your-resume-open-source
