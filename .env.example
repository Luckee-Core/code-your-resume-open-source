# Optional: backend API base URL (no trailing slash)
# NEXT_PUBLIC_API_URL=http://localhost:3009

# CRM + User Background Studio: Next rewrites /api/data/* and /api/user-background-studio/* → Express.
# In `next dev`, defaults to http://127.0.0.1:3053 if unset.
# Override (no trailing slash): CRM_EXPRESS_INTERNAL_URL=http://127.0.0.1:3053

# Shared secret for CRM Express (same value as Express `CRM_API_SECRET`). Server-only — not NEXT_PUBLIC_*.
# Middleware and the skills-component BFF route add `X-CRM-API-Key` when set.
# CRM_API_SECRET=

# Dev user id passed to UBS handlers (must exist in your Supabase DB). Default in code: dev-user-001.
# NEXT_PUBLIC_MENTORAI_USER_ID=dev-user-001
